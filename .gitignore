# KUKIA — nunca publicar secretos ni datos locales.
# (Protege la red: la BD, el token admin y las wallets quedan fuera del repo.)

# Bases de datos SQLite locales (ledger de pruebas incluido)
*.db
*.db-journal
*.db-wal
*.db-shm

# Token de administracion del Core (kukia_core.py lo genera solo)
admin_token.txt

# Wallets locales (claves privadas y mnemonicos en texto plano)
ledger/wallet/
coordinator/ledger/wallet/
dashboard/ledger/wallet/
worker/ledger/wallet/
*_hist.json

# Secretos y entorno
.env
*.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# Node / frontend build
node_modules/
dist/
.npm/

# Sistema y temporales
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.log
