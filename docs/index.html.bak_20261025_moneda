<script>
// Metricas en vivo. La web publica lee /api/metricas del rele (docs/metricas.json);
// en el mismo PC, ?core=http://127.0.0.1:8300 lee el Core directo (sin rele).
(function(){
  var porId = function(id){ return document.getElementById(id); };
  if(!porId('stSupply')) return;
  var dot = porId('liveDot'), txt = porId('liveText');
  var base = '', ruta = '/api/metricas', prev = null, prevT = 0, tsDatos = 0, tsAnterior = 0;
  // ?core= solo se acepta contra la propia maquina (loopback). Si se aceptara
