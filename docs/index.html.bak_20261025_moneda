  // El ancla publicada es el ultimo sello firmado por el Core. Se comprueba
  // aqui, sin fiarse del rele: la clave publica va FIJADA en el codigo, no se
  // acepta la que venga en el mensaje (si no, quien controle el rele podria
  // firmar su propia historia con su propia clave y pasarla por buena).
  //
  // OJO con el cuerpo firmado: el sello se firma SIN `firma` y SIN
  // `clave_publica` (ese campo lo anade el rele al publicar). Meterlo en el
  // mensaje hacia que NINGUNA firma cuadrase: comprobado el 21-10-2026.
  var CLAVE_SELLO = '2013664e12b4ac93f5a266ae5e1a4a071f51c68112e1209fae5d501ecb2f8d1c';
  var CLAVE_VISTA = 'kukia_ancla_visto';
  function hexBytes(h){
    h = String(h || '').replace(/[^0-9a-f]/gi, '');
    if(!h.length || h.length % 2) return null;
    var out = new Uint8Array(h.length / 2);
    for(var i=0;i<out.length;i++) out[i] = parseInt(h.substr(i*2, 2), 16);
    return out;
  }
  function u8(t){ return new TextEncoder().encode(t); }
  // JSON canonico identico a ledger/sellos.py: claves ordenadas, sin espacios.
  // `suma` es float en Python y se escribe siempre con parte decimal ("123.0"
  // si es entera); el resto son enteros o textos.
  function numPy(v){
    var s = String(v);
    return (s.indexOf('.') < 0 && s.indexOf('e') < 0 && s.indexOf('E') < 0) ? s + '.0' : s;
  }
  function canonicoSello(o){
    var claves = Object.keys(o).filter(function(k){ return k !== 'firma' && k !== 'clave_publica'; }).sort();
    var partes = [];
    for(var i=0;i<claves.length;i++){
      var k = claves[i], v = o[k];
      if(k === 'legado' && v && typeof v === 'object') partes.push(JSON.stringify(k) + ':' + canonicoSello(v));
      else if(k === 'suma') partes.push(JSON.stringify(k) + ':' + numPy(v));
      else partes.push(JSON.stringify(k) + ':' + JSON.stringify(v));
