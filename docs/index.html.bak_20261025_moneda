<script>
// Red de nodos GPU animada (fondo cyber del hero)
(function(){
  var cv = document.getElementById('netcanvas');
  if(!cv) return;
  var ctx = cv.getContext('2d');
  var W, H, nodes = [];
  function resize(){
    var r = cv.parentElement.getBoundingClientRect();
    W = cv.width = r.width; H = cv.height = r.height;
  }
  window.addEventListener('resize', resize); resize();
  var N = 45;
  for(var i=0;i<N;i++){
    nodes.push({x: Math.random(), y: Math.random(),
      vx: (Math.random()-.5)*0.0009, vy: (Math.random()-.5)*0.0009,
      r: 1.5+Math.random()*2.2, gpu: Math.random() < 0.25});
  }
  function frame(){
    ctx.clearRect(0,0,W,H);
    var i, j, a, b, dx, dy, d;
    for(i=0;i<nodes.length;i++){
      a = nodes[i];
      a.x += a.vx; a.y += a.vy;
      if(a.x<0||a.x>1) a.vx*=-1;
      if(a.y<0||a.y>1) a.vy*=-1;
    }
    for(i=0;i<nodes.length;i++){
      a = nodes[i];
      for(j=i+1;j<nodes.length;j++){
        b = nodes[j];
        dx = (a.x-b.x)*W; dy = (a.y-b.y)*H;
        d = Math.sqrt(dx*dx+dy*dy);
        if(d < 170){
          var alpha = (1 - d/170) * 0.55;
          ctx.strokeStyle = (a.gpu||b.gpu)
            ? 'rgba(0,255,136,'+alpha+')'
            : 'rgba(0,229,255,'+(alpha*0.7)+')';
          ctx.lineWidth = (a.gpu||b.gpu) ? 1.4 : 0.8;
          ctx.beginPath(); ctx.moveTo(a.x*W, a.y*H); ctx.lineTo(b.x*W, b.y*H); ctx.stroke();
        }
      }
    }
    for(i=0;i<nodes.length;i++){
      a = nodes[i];
      if(a.gpu){
        ctx.fillStyle = '#00ff88';
        ctx.shadowColor = '#00ff88'; ctx.shadowBlur = 12;
        ctx.fillRect(a.x*W-3, a.y*H-3, 6, 6);
        ctx.shadowBlur = 0;
      } else {
        ctx.fillStyle = 'rgba(0,229,255,.85)';
        ctx.beginPath(); ctx.arc(a.x*W, a.y*H, a.r, 0, 6.283); ctx.fill();
      }
    }
    requestAnimationFrame(frame);
  }
  frame();
})();
</script>
