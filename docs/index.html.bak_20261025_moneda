    grad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.beginPath(); ctx.moveTo(x(0), y(vals[0]));
    for(var i=1; i<vals.length; i++) ctx.lineTo(x(i), y(vals[i]));
    ctx.lineTo(x(vals.length-1), h - 18); ctx.lineTo(x(0), h - 18); ctx.closePath();
    ctx.fillStyle = grad; ctx.fill();
    ctx.beginPath(); ctx.moveTo(x(0), y(vals[0]));
    for(i=1; i<vals.length; i++) ctx.lineTo(x(i), y(vals[i]));
    ctx.strokeStyle = col; ctx.lineWidth = 2; ctx.stroke();
    ctx.beginPath(); ctx.arc(x(vals.length-1), y(vals[vals.length-1]), 3, 0, 6.283);
    ctx.fillStyle = col; ctx.fill();
    ctx.fillStyle = '#9db6dd'; ctx.textAlign = 'left';
    ctx.fillText(Math.round(max).toLocaleString('es-ES'), 6, 11);
    ctx.fillText(Math.round(min).toLocaleString('es-ES'), 6, h - 20);
  }
  window.addEventListener('resize', function(){ if(serie.length > 1) pintarSerie(); });

  tick();
  setInterval(tick, POLL);
  // Al volver a la pestana se pide de inmediato: si estuvo oculta, el dato
  // que se ve es viejo y conviene refrescarlo ya.
  document.addEventListener('visibilitychange', function(){ if(!document.hidden) tick(); });
  setInterval(function(){
    if(respaldoBase){ pintarRespaldoAhora(); }
    else if(Date.now() < pausaHasta){
      texto(pausaMsg + ' · reintento en ' + Math.ceil((pausaHasta - Date.now())/1000) + ' s');
    } else if(tsDatos && Date.now() - tsDatos < 180000){ texto('EN VIVO · origen: relé · ultima actualizacion ' + hace() + ' · refresco 1 min' + marcaSello()); }
  }, 1000);
})();
</script>
<script>
// Menu de movil (24-10-2026). Sin JS, el boton no se ve y la barra queda como
// estaba antes. Cierra al elegir un enlace, al hacer clic fuera y con Escape.
(function(){
  var btn = document.getElementById('menuBtn');
  var ul = document.getElementById('menuPrincipal');
  if(!btn || !ul) return;
  function cerrar(){ ul.classList.remove('abierto'); btn.setAttribute('aria-expanded','false'); btn.setAttribute('aria-label','Abrir menu'); }
  btn.addEventListener('click', function(){
    var abierto = ul.classList.toggle('abierto');
    btn.setAttribute('aria-expanded', abierto ? 'true' : 'false');
    btn.setAttribute('aria-label', abierto ? 'Cerrar menu' : 'Abrir menu');
  });
  ul.addEventListener('click', function(e){ if(e.target.closest('a')) cerrar(); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape') cerrar(); });
  document.addEventListener('click', function(e){ if(!e.target.closest('nav')) cerrar(); });
})();
</script>

<script>
/* Modo de los datos: se deduce del semaforo que ya pinta el script de metricas,
   para que quede escrito si el numero es de ahora o de la copia guardada. */
(function(){
  var dot=document.getElementById('liveDot'), txt=document.getElementById('liveText'),
      modo=document.getElementById('liveModo');
  if(!modo) return;
  function pintar(){
    var t=((txt&&txt.textContent)||'').toUpperCase();
    if(t.indexOf('EN VIVO')===0){ modo.textContent='datos en vivo'; modo.className='modo vivo'; }
    else if(t.indexOf('INSTANTANEA')===0){ modo.textContent='instantánea firmada'; modo.className='modo cache'; }
    else if(t.indexOf('ANTIGUOS')>=0){ modo.textContent='copia guardada'; modo.className='modo cache'; }
    else if(t.indexOf('DESCONECTADO')>=0){ modo.textContent='sin datos'; modo.className='modo'; }
    else { modo.textContent='comprobando…'; modo.className='modo'; }
  }
  if(window.MutationObserver){
    new MutationObserver(pintar).observe(document.body,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['style']});
  }
  setInterval(pintar,1500); pintar();
})();
</script>
<script>
/* Calculadora: la cuenta es la definicion (1 KIA = 1 minuto de GPU = 900.000 GFLOP).
   No hay precio en euros porque no hay mercado: aqui solo salen KIA. */
(function(){
  var g=document.getElementById('calcGpu'), f=document.getElementById('calcFlops'),
      h=document.getElementById('calcHoras'), u=document.getElementById('calcUso'),
      out=document.getElementById('calcKia'), outh=document.getElementById('calcKiaHora');
  if(!g||!f||!out) return;
  function nf(n){ return n.toLocaleString('es-ES',{minimumFractionDigits:3,maximumFractionDigits:3}); }
  function calc(){
    var flops=Math.max(1,Number(f.value)||0),
        horas=Math.min(24,Math.max(1,Number(h.value)||0)),
        uso=Math.min(100,Math.max(1,Number(u.value)||0));
    var kiaHora=flops*3600/900000*(uso/100);
    out.textContent=nf(kiaHora*horas);
    outh.textContent=nf(kiaHora);
  }
  g.addEventListener('change',function(){ if(g.value!=='custom'){ f.value=g.value; } calc(); });
  f.addEventListener('input',calc); h.addEventListener('input',calc); u.addEventListener('input',calc);
  calc();
})();
</script>
