<style>
/* ============================================================
   KUKIA · sistema de diseño v1.3
   Un solo sitio para los colores y el ritmo. Nada de estilos sueltos
   por el cuerpo: si algo se ve mal, se arregla aqui.
   ============================================================ */
:root{
  --fondo:#050d0a;          /* casi negro con verde */
  --fondo2:#08150f;
  --panel:#0b1a13;
  --panel2:#0e2118;
  --linea:#1d3a2b;
  --linea2:#2a5240;
  --texto:#e8f2ec;
  --texto2:#a9c2b4;         /* secundario, contraste 6.4:1 sobre --panel */
  --mint:#22e08a;
  --mint2:#0fb96e;
  --oro:#e6bd4b;
  --rojo:#ff6b6b;
  --radio:14px;
  --ancho:1120px;
  --sombra:0 18px 48px rgba(0,0,0,.45);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.001ms!important;transition-duration:.001ms!important}}
body{font-family:ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  background:var(--fondo);color:var(--texto);line-height:1.65;font-size:16px;
  overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,
summary:focus-visible,textarea:focus-visible{outline:3px solid var(--oro);outline-offset:2px;border-radius:6px}
h1,h2,h3{line-height:1.2;letter-spacing:-.02em}
h2{font-size:clamp(1.5rem,3.6vw,2.1rem);margin-bottom:.6rem}
h3{font-size:1.06rem;margin-bottom:.35rem}
p{color:var(--texto2)}
strong{color:var(--texto)}
code{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.86em;
  background:#08201a;border:1px solid var(--linea);border-radius:6px;padding:.1em .4em;color:#bfe9d6}
.contenedor{max-width:var(--ancho);margin:0 auto;padding:0 1.25rem}
section[id],div[id]{scroll-margin-top:84px}
.salto{position:absolute;left:-999px;top:0;background:var(--mint);color:#04120b;
  padding:.7rem 1rem;z-index:200;font-weight:700}
.salto:focus{left:8px;top:8px}

/* ---------- barra ---------- */
header.barra{position:sticky;top:0;z-index:100;background:rgba(5,13,10,.86);
  backdrop-filter:blur(14px);border-bottom:1px solid var(--linea)}
.barra .dentro{display:flex;align-items:center;gap:1.2rem;height:64px;
  max-width:var(--ancho);margin:0 auto;padding:0 1.25rem}
.logo{display:flex;align-items:center;gap:.55rem;font-weight:800;letter-spacing:.16em;
  color:var(--mint);font-size:1rem;text-decoration:none;white-space:nowrap}
.logo img{width:26px;height:26px;border-radius:50%;border:1px solid var(--linea2)}
.logo small{font-weight:600;letter-spacing:.06em;color:var(--texto2);font-size:.72rem;
  border-left:1px solid var(--linea2);padding-left:.55rem}
.barra nav{margin-left:auto;display:flex;align-items:center;gap:.6rem}
.barra ul{display:flex;align-items:center;gap:1.35rem;list-style:none}
.barra ul a{text-decoration:none;color:var(--texto2);font-size:.9rem;white-space:nowrap}
.barra ul a:hover{color:var(--mint)}
.menu-btn{display:none;background:none;border:1px solid var(--linea2);
  color:var(--texto);border-radius:9px;padding:.4rem .65rem;font-size:1.05rem;cursor:pointer}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;
  padding:.8rem 1.5rem;border-radius:999px;font-weight:700;text-decoration:none;
  border:1px solid transparent;cursor:pointer;font-size:.95rem;transition:.18s;white-space:nowrap}
.btn-principal{background:var(--mint);color:#04160e;box-shadow:0 8px 26px rgba(34,224,138,.22)}
.btn-principal:hover{background:#3df0a1;transform:translateY(-1px)}
.btn-secundario{border-color:var(--linea2);color:var(--texto);background:rgba(11,26,19,.7)}
.btn-secundario:hover{border-color:var(--mint);color:var(--mint)}
.btn-pequeno{padding:.5rem .95rem;font-size:.86rem}
@media (max-width:920px){
  .barra ul{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;
    align-items:stretch;gap:0;background:#071410;border-bottom:1px solid var(--linea);padding:.4rem 1.25rem 1rem}
  .barra ul.abierto{display:flex}
  .barra ul li{border-top:1px solid rgba(255,255,255,.06)}
  .barra ul a{display:block;padding:.85rem 0;font-size:1rem}
  .menu-btn{display:block}
  .barra .cta-barra{display:none}
}

/* ---------- portada ---------- */
.portada{position:relative;overflow:hidden;border-bottom:1px solid var(--linea);
  background:radial-gradient(900px 420px at 18% -10%,rgba(34,224,138,.13),transparent 65%),
             radial-gradient(700px 380px at 90% 0%,rgba(230,189,75,.08),transparent 60%),
             var(--fondo)}
.portada canvas{position:absolute;inset:0;width:100%;height:100%;opacity:.5;pointer-events:none}
.portada .dentro{position:relative;padding:5.5rem 1.25rem 3.5rem;max-width:var(--ancho);margin:0 auto}
.etiqueta{display:inline-flex;align-items:center;gap:.5rem;font-size:.78rem;letter-spacing:.09em;
  text-transform:uppercase;color:var(--oro);border:1px solid rgba(230,189,75,.35);
  background:rgba(230,189,75,.07);padding:.35rem .8rem;border-radius:999px;margin-bottom:1.4rem}
.portada h1{font-size:clamp(2.05rem,5.4vw,3.5rem);max-width:19ch;margin-bottom:1.1rem}
.portada h1 em{font-style:normal;color:var(--mint)}
.entradilla{font-size:clamp(1rem,2vw,1.16rem);max-width:62ch;color:var(--texto2)}
.acciones{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}
.mini{display:flex;flex-wrap:wrap;gap:.5rem 1.4rem;margin-top:1.6rem;font-size:.84rem;color:var(--texto2)}
.mini span{display:inline-flex;align-items:center;gap:.4rem}
.mini b{color:var(--texto)}
.punto{width:7px;height:7px;border-radius:50%;background:var(--mint);box-shadow:0 0 10px var(--mint)}
.punto.oro{background:var(--oro);box-shadow:0 0 10px var(--oro)}

/* ---------- tarjetas ---------- */
.rejilla{display:grid;gap:1rem}
.rejilla-4{grid-template-columns:repeat(auto-fit,minmax(235px,1fr))}
.rejilla-3{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.rejilla-2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
article.caja,div.caja{background:linear-gradient(170deg,var(--panel2),var(--panel));
  border:1px solid var(--linea);border-radius:var(--radio);padding:1.35rem 1.25rem}
article.caja:hover{border-color:var(--linea2)}
article.caja h3{color:var(--texto)}
article.caja p{font-size:.92rem}
.icono{font-size:1.35rem;line-height:1;margin-bottom:.6rem;display:block}

/* ---------- secciones ---------- */
.bloque{padding:4.2rem 0}
.bloque.alt{background:linear-gradient(180deg,var(--fondo2),var(--fondo));border-top:1px solid var(--linea);border-bottom:1px solid var(--linea)}
.bloque .cabeza{max-width:66ch;margin-bottom:2rem}
.bloque .cabeza p{font-size:1rem}
.ojo{font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;color:var(--mint);font-weight:700;margin-bottom:.5rem;display:block}

/* ---------- caminos ---------- */
.camino{display:grid;gap:1.5rem;grid-template-columns:1fr 1fr}
@media (max-width:860px){.camino{grid-template-columns:1fr}}
.camino .caja{padding:1.7rem 1.5rem}
.camino h3{font-size:1.25rem;margin-bottom:.3rem;color:var(--mint)}
.camino .sub{font-size:.9rem;color:var(--texto2);margin-bottom:1.1rem}
.camino ul{list-style:none;display:grid;gap:.55rem;margin:0 0 1.2rem}
.camino li{font-size:.92rem;color:var(--texto2);padding-left:1.4rem;position:relative}
.camino li::before{content:'✓';position:absolute;left:0;color:var(--mint);font-weight:700}
.pasos{counter-reset:p;list-style:none;display:grid;gap:.85rem;margin:1rem 0 1.3rem}
.pasos li{list-style:none;position:relative;padding:0 0 0 2.3rem;
  font-size:.92rem;color:var(--texto2)}
.pasos li::before{counter-increment:p;content:counter(p);position:absolute;left:0;top:.05rem;
  width:24px;height:24px;display:flex;align-items:center;justify-content:center;
  border-radius:50%;background:rgba(34,224,138,.14);color:var(--mint);
  font-weight:700;font-size:.8rem;border:1px solid rgba(34,224,138,.35)}
.pasos b{color:var(--texto)}

/* ---------- datos en vivo ---------- */
.medidor{display:flex;align-items:center;gap:.55rem;font-size:.82rem;color:var(--texto2);
  margin-bottom:1.1rem;flex-wrap:wrap}
.medidor .modo{border:1px solid var(--linea2);border-radius:999px;padding:.15rem .6rem;font-size:.74rem;
  letter-spacing:.04em;text-transform:uppercase}
.medidor .modo.vivo{color:var(--mint);border-color:rgba(34,224,138,.4)}
.medidor .modo.cache{color:var(--oro);border-color:rgba(230,189,75,.4)}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.9rem}
.stat{background:var(--panel);border:1px solid var(--linea);border-radius:var(--radio);
  padding:1.05rem .9rem;text-align:center}
.stat .n{display:block;font-size:clamp(1.2rem,3.4vw,1.75rem);font-weight:800;color:var(--mint);
  font-variant-numeric:tabular-nums;letter-spacing:-.02em;white-space:nowrap}
.stat .l{display:block;font-size:.78rem;color:var(--texto2);margin-top:.25rem}
.graficas{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1.2rem}
@media (max-width:820px){.graficas{grid-template-columns:1fr}}
.grafica{background:var(--panel);border:1px solid var(--linea);border-radius:var(--radio);padding:.9rem}
.grafica.ancha{grid-column:1/-1}
.grafica .cab{display:flex;justify-content:space-between;gap:.6rem;font-size:.82rem;
  color:var(--texto2);margin-bottom:.5rem}
.grafica .cab b{color:var(--oro);font-weight:700}
.grafica canvas{width:100%;height:170px;display:block}
.pastel{margin-top:.4rem;font-size:.75rem;color:var(--texto2);text-align:center}
.nota{font-size:.84rem;color:var(--texto2);max-width:78ch;margin-top:1.1rem}
.nota strong{color:var(--texto)}

/* ---------- calculadora ---------- */
.calc{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem}
@media (max-width:860px){.calc{grid-template-columns:1fr}}
.calc .campos{display:grid;gap:.85rem}
.calc label{font-size:.85rem;color:var(--texto2);display:grid;gap:.3rem}
.calc input,.calc select{background:#061c15;border:1px solid var(--linea2);color:var(--texto);
  padding:.6rem .7rem;border-radius:9px;font-size:.95rem;width:100%}
.calc .resultado{background:linear-gradient(170deg,rgba(34,224,138,.1),var(--panel));
  border:1px solid rgba(34,224,138,.3);border-radius:var(--radio);padding:1.3rem}
.calc .grande{font-size:clamp(1.5rem,4vw,2.1rem);font-weight:800;color:var(--mint);
  font-variant-numeric:tabular-nums;display:block;line-height:1.1}
.calc .unidad{font-size:.85rem;color:var(--texto2)}
.calc .formula{margin-top:.9rem;font-size:.8rem;color:var(--texto2);
  border-top:1px dashed var(--linea2);padding-top:.8rem}
.aviso{border-left:3px solid var(--oro);background:rgba(230,189,75,.06);
  padding:.85rem 1rem;border-radius:0 10px 10px 0;font-size:.88rem;color:var(--texto2);margin-top:1.4rem}
.aviso b{color:var(--oro)}

/* ---------- confianza ---------- */
.lista-check{list-style:none;display:grid;gap:.65rem}
.lista-check li{display:grid;grid-template-columns:22px 1fr;gap:.6rem;font-size:.92rem;color:var(--texto2)}
.lista-check li span:first-child{font-weight:800}
.si{color:var(--mint)}
.no{color:var(--oro)}
.riesgo{color:var(--rojo)}
table.datos{width:100%;border-collapse:collapse;font-size:.9rem}
table.datos th,table.datos td{text-align:left;padding:.6rem .7rem;border-bottom:1px solid var(--linea)}
table.datos th{color:var(--texto2);font-weight:600;font-size:.8rem;text-transform:uppercase;letter-spacing:.05em}
table.datos td b{color:var(--mint)}
.faq{display:grid;gap:.7rem;max-width:820px}
details.qa{background:var(--panel);border:1px solid var(--linea);border-radius:12px;overflow:hidden}
details.qa summary{cursor:pointer;padding:1rem 1.1rem;font-weight:600;color:var(--texto);
  list-style:none;position:relative;font-size:.95rem}
details.qa summary::-webkit-details-marker{display:none}
details.qa summary::after{content:'+';position:absolute;right:1.1rem;top:50%;transform:translateY(-50%);
  color:var(--mint);font-size:1.2rem;transition:.2s}
details.qa[open] summary::after{transform:translateY(-50%) rotate(45deg)}
details.qa .resp{padding:0 1.1rem 1rem;font-size:.9rem;color:var(--texto2)}
details.qa .resp a{color:var(--oro)}

/* ---------- formulario ---------- */
.form-box{background:linear-gradient(170deg,var(--panel2),var(--panel));border:1px solid var(--linea2);
  border-radius:var(--radio);padding:1.6rem 1.4rem;max-width:560px}
.form-box h3{color:var(--texto)}
.form-box input,.form-box select{width:100%;margin:.45rem 0;padding:.7rem .8rem;border-radius:9px;
  border:1px solid var(--linea2);background:#061c15;color:var(--texto);font-size:.95rem}
.form-box small{display:block;color:var(--texto2);font-size:.78rem;margin-top:.6rem}

/* ---------- pie ---------- */
footer{border-top:1px solid var(--linea);background:#04100b;padding:3rem 0 2.4rem;font-size:.86rem}
footer .cols{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:1.5rem}
@media (max-width:820px){footer .cols{grid-template-columns:1fr 1fr}}
footer h4{font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;color:var(--texto2);margin-bottom:.7rem}
footer ul{list-style:none;display:grid;gap:.45rem}
footer a{color:var(--texto2);text-decoration:none}
footer a:hover{color:var(--mint)}
footer .legal{margin-top:2rem;padding-top:1.2rem;border-top:1px solid var(--linea);
  color:#6f8a7d;font-size:.78rem;display:grid;gap:.4rem}

/* ---------- animación de entrada (mejora progresiva) ----------
   Ojo con esto: si el contenido arranca en opacity:0 y el que lo enseña es
   JavaScript, quien navegue sin JS (o con un fallo de script) se queda con una
   pagina vacia. Aqui el contenido se ve siempre; solo se oculta cuando el
   propio navegador ha declarado que hay JS (clase .js en <html>). */
.reveal{opacity:1;transform:none}
.js .reveal{opacity:0;transform:translateY(18px);transition:opacity .5s ease,transform .5s ease}
.js .reveal.visible{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.js .reveal{opacity:1;transform:none}}
</style>
