  var modoLocal = false;
  function marcaSello(){ return modoLocal ? ' · modo local (sin sello)' : ' · sello verificado'; }
  function compact(n){
    if(typeof n !== 'number' || !isFinite(n)) return '—';
    if(n >= 1000000) return (n/1000000).toLocaleString('es-ES',{maximumFractionDigits:2}) + 'M';
    return Math.round(n).toLocaleString('es-ES');
  }
  function entero(n){ return (typeof n === 'number' && isFinite(n)) ? Math.round(n).toLocaleString('es-ES') : '—'; }
  function set(id, v){ var e = porId(id); if(e) e.textContent = v; }
