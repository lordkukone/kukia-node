# AVISO DE RUTA (24/10/2026): docker-compose.yml lee `env_file: .env` RELATIVO a su
# propia carpeta. El destino bueno es despliegue/.env, NO un .env en la raiz:
#     cp despliegue/.env.ejemplo despliegue/.env
#     nano despliegue/.env
# Un .env en la raiz del proyecto no se lee y el Core arranca sin esa configuracion.

# Copia esto a .env en el servidor y rellena lo tuyo.
# El .env NO se sube a git (esta ignorado).

# --- Rutas dentro del contenedor (no cambiar si usas el compose de aqui) ---
KUKIA_DB=/datos/kukia.db
KUKIA_SELLO_KEY=/claves/sello_key.txt
KUKIA_ADMIN_TOKEN=/claves/admin_token.txt

# --- Dominio y origenes ---
# Quien puede llamar al Core desde un navegador. Con esto cerrado, una web
# ajena no puede hacer peticiones en nombre de un usuario.
# Incluye tu web publica y el propio dominio del Core.
KUKIA_ORIGENES=https://kukia-network.surge.sh,https://lordkukone.github.io,https://TU_DOMINIO

# Detras de Caddy: aceptar las cabeceras del proxy para ver la IP real.
KUKIA_CONFIA_PROXY=1

# --- Economia (los valores por defecto ya son los de produccion) ---
KUKIA_PAGO_POR_FLOP=1
KUKIA_PARTE_REPLICA=0.3
KUKIA_AUDITORIA_1_DE=10
KUKIA_AUDITORIA_1_DE_JOVEN=1
KUKIA_FUSIBLE_MINUTO_X=2.0

# --- Limpieza automatica ---
KUKIA_SIN_TRABAJO_H=0
KUKIA_PODA_NODOS_H=72
